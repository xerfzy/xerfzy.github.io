{
  "name": "xerf-portfolio",
  "private": true,
  "description": "Static portfolio site. The site itself has no runtime dependencies; these packages are for checks only.",
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:links": "node scripts/check-external-links.mjs",
    "test": "playwright test",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "html-validate": "11.17.0"
  }
}
